{
    "name": "nz-fuel-price-project",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

    "features": {
        "ghcr.io/devcontainers/features/azure-cli:1": {}
    },

    "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && sh -c \"$(curl -sSL https://taskfile.dev/install.sh)\" -- -d -b /usr/local/bin",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "innoverio.vscode-dbt-power-user"
            ]
        }
    },

    "remoteEnv": {
        "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/.dbt"
    }
}
