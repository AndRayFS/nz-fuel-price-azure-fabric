table 'Lag Weeks'
	lineageTag: 2532706a-b466-4fca-a1c2-4a4521217a70

	measure 'Lag Weeks Value' = SELECTEDVALUE('Lag Weeks'[Lag Weeks], 0)
		formatString: 0
		lineageTag: 9e6acb59-ae95-4cb0-830a-0d71869788d7

	measure 'Selected Correlation' =
			
			VAR SelLag = SELECTEDVALUE('Lag Weeks'[Lag Weeks], 0)
			RETURN
			CALCULATE(
			    MAX(lag_correlation[r]),
			    lag_correlation[lag_weeks] = SelLag
			)
		lineageTag: 6d0fa511-2c50-4206-baaf-d2e267fe0d41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Value' =
			
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR SelTarget = SELECTEDVALUE(lag_correlation[target])
			RETURN
			CALCULATE(
			    SWITCH(
			        SelTarget,
			        "board_price", SUM(silver_fuel[board_price]),
			        "adjusted_retail_price", SUM(silver_fuel[adjusted_retail_price])
			    ),
			    silver_fuel[Fuel] = SelFuel
			)
		lineageTag: c353b597-240c-46ea-9ab6-affdb14e2971

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Shifted Factor Value' =
			
			VAR SelFactor = SELECTEDVALUE(lag_correlation[factor])
			VAR SelLagWeeks = SELECTEDVALUE('Lag Weeks'[Lag Weeks], 0)
			VAR CurrentDate = MIN(silver_fuel[Date])
			VAR ShiftedDate = CurrentDate - (SelLagWeeks * 7)
			RETURN
			CALCULATE(
			    SWITCH(
			        SelFactor,
			        "dubai_crude_usd", SUM(silver_general[dubai_crude_usd]),
			        "dubai_crude_nzd", SUM(silver_general[dubai_crude_nzd]),
			        "exchange_rate", SUM(silver_general[exchange_rate])
			    ),
			    silver_general[Date] = ShiftedDate,
			    ALL(silver_general)
			)
		lineageTag: b65f5b0a-4543-4674-b6ac-c553ac45aa7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volatility vs Calm Baseline (Live)' = ```
			
			VAR LatestDate = CALCULATE(MAX(factor_volatility[Date]), ALL(factor_volatility))
			VAR CurrentVol = 
			    CALCULATE(
			        MAX(factor_volatility[rolling_volatility]),
			        factor_volatility[Date] = LatestDate,
			        ALL(factor_volatility)
			    )
			VAR Baseline = MAX(volatility_config[calm_baseline])
			RETURN
			DIVIDE(CurrentVol, Baseline)
			```
		lineageTag: 2456d7f1-60f0-4e4b-945f-177f7104e804

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volatility Trend' = ```
			
			VAR LatestDate = CALCULATE(MAX(factor_volatility[Date]), ALL(factor_volatility))
			VAR HalfWindowDays = MAX(volatility_config[window_days]) / 2
			VAR RecentAvg = 
			    CALCULATE(
			        AVERAGE(factor_volatility[rolling_volatility]),
			        DATESINPERIOD(silver_general[Date], LatestDate, -HalfWindowDays, DAY)
			    )
			VAR PriorAvg = 
			    CALCULATE(
			        AVERAGE(factor_volatility[rolling_volatility]),
			        DATESINPERIOD(silver_general[Date], LatestDate - HalfWindowDays, -HalfWindowDays, DAY)
			    )
			RETURN
			IF(RecentAvg < PriorAvg, "↓ easing", "↑ intensifying")
			```
		lineageTag: 127c6038-dcef-4c8d-aefb-6853725d84bf

	measure 'Crude Price Change Over Window' = ```
			
			VAR LatestDate = CALCULATE(MAX(factor_volatility[Date]), ALL(factor_volatility))
			VAR WindowDays = MAX(volatility_config[window_days])
			VAR PriorDate = LatestDate - WindowDays
			VAR CurrentPrice = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = LatestDate, ALL(silver_general))
			VAR PriorPrice = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = PriorDate, ALL(silver_general))
			RETURN
			DIVIDE(CurrentPrice - PriorPrice, PriorPrice)
			```
		lineageTag: 423c9219-1714-4c15-b3ca-f4408339dadd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Pct Change' = ```
			
			VAR SelFactor = SELECTEDVALUE(lag_correlation[factor])
			VAR SelTarget = SELECTEDVALUE(lag_correlation[target])
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(
			            ALL(periods),
			            periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date])))
			        )
			    )
			VAR ResolvedLag = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_lag]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = SelFactor,
			        lag_resolved[target] = SelTarget,
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Slope = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_slope]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = SelFactor,
			        lag_resolved[target] = SelTarget,
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR LatestDate = CALCULATE(MAX(silver_general[Date]), ALL(silver_general))
			VAR LagDays = ResolvedLag * 7
			VAR PriorDate = LatestDate - LagDays
			VAR CurrentCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = LatestDate, ALL(silver_general))
			VAR PriorCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = PriorDate, ALL(silver_general))
			VAR CrudeChangeAbsolute = CurrentCrude - PriorCrude
			VAR ForecastPriceChange = Slope * CrudeChangeAbsolute
			VAR CurrentTargetPrice = 
			    CALCULATE(
			        MAX(silver_fuel[adjusted_retail_price]),
			        silver_fuel[Fuel] = SelFuel,
			        silver_fuel[Date] = LatestDate,
			        ALL(silver_fuel)
			    )
			RETURN
			DIVIDE(ForecastPriceChange, CurrentTargetPrice)
			```
		lineageTag: 5ef5903d-f1ce-4d05-b44d-26649b34b58b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Confidence' = ```
			
			VAR SelFactor = SELECTEDVALUE(lag_correlation[factor])
			VAR SelTarget = SELECTEDVALUE(lag_correlation[target])
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(
			            ALL(periods),
			            periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date])))
			        )
			    )
			VAR SelR = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_r]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = SelFactor,
			        lag_resolved[target] = SelTarget,
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    ABS(SelR) >= 0.7, "Strong",
			    ABS(SelR) >= 0.5, "Moderate",
			    "Weak — forecast not shown"
			)
			```
		lineageTag: 22160b8a-6b90-4bae-8464-92ca62cbbe75

	measure 'Forecast Display' =
			
			VAR Confidence = [Forecast Confidence]
			VAR Pct = [Forecast Pct Change]
			RETURN
			IF(
			    Confidence = "Weak — forecast not shown",
			    "Insufficient historical signal for this fuel right now",
			    FORMAT(Pct, "+0.0%;-0.0%") & " (" & Confidence & " confidence)"
			)
		lineageTag: 6d836974-f4a4-4c8c-b598-1215b8a75fd7

