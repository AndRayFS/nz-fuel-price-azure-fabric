	measure Measure
		lineageTag: b43ae086-714b-4019-aea1-3e793db7c052

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Report1 When Short' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelLag = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_lag]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Gap = 
			    CALCULATE(
			        MAX(lag_resolved[lag_confidence_gap]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR LatestDataDate = CALCULATE(MAX(silver_general[Date]), ALL(silver_general))
			VAR TargetDate = LatestDataDate + (SelLag * 7)
			VAR TargetDateEarlier = LatestDataDate + ((SelLag - 1) * 7)
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "Same week",
			    "weak", "—",
			    IF(
			        Gap < 0.02,
			        FORMAT(TargetDateEarlier, "d MMM") & "–" & FORMAT(TargetDate, "d MMM"),
			        FORMAT(TargetDate, "d MMMM")
			    )
			)
			```
		lineageTag: fb392fcb-58fe-4de2-8b03-503a81e006e2

	measure 'Report1 Strength Short' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelR = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_r]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Prominence = 
			    CALCULATE(
			        MAX(lag_resolved[peak_prominence]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "Uncertain",
			    SWITCH(
			        TRUE(),
			        ABS(SelR) >= 0.7, "Strong",
			        ABS(SelR) >= 0.5, "Moderate",
			        "Weak"
			    )
			)
			```
		lineageTag: d6093d40-4782-4552-91a4-400fbb03d31f

	measure 'Confidence Color' =
			
			VAR Tier = [Report1 Strength Short]
			RETURN
			SWITCH(
			    Tier,
			    "Strong", "#15803d",
			    "Moderate", "#b45309",
			    "Weak", "#dc2626",
			    "Uncertain", "#dc2626",
			    "#1a1a1a"
			)
