	measure 'Report1 How Much Short' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelLag = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_lag]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Slope = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_slope]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR LatestDate = CALCULATE(MAX(silver_general[Date]), ALL(silver_general))
			VAR LagDays = SelLag * 7
			VAR PriorDate = LatestDate - LagDays
			VAR CurrentCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = LatestDate, ALL(silver_general))
			VAR PriorCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = PriorDate, ALL(silver_general))
			VAR ContributionCents = Slope * (CurrentCrude - PriorCrude)
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "n/a",
			    "weak", "—",
			    IF(ContributionCents >= 0, "+ ", "− ") & FORMAT(ABS(ContributionCents), "0.0") & " c/L"
			)
			
