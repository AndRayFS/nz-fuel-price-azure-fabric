	measure 'Test Fixed Fuel Selection' = SELECTEDVALUE(lag_correlation[fuel])
		lineageTag: 358978be-a4ae-4a1f-9e86-ae7dd1d456e4

	measure 'Is In Current Period' = ```
			
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR PStart = CALCULATE(MAX(periods[start_date]), periods[period_id] = CurrentPeriodId, ALL(periods))
			VAR PEnd = CALCULATE(MAX(periods[end_date]), periods[period_id] = CurrentPeriodId, ALL(periods))
			VAR EffectiveEnd = IF(ISBLANK(PEnd), TODAY(), PEnd)
			VAR ThisDate = MAX(silver_fuel[Date])
			RETURN
			IF(ThisDate >= PStart && ThisDate <= EffectiveEnd, 1, 0)
			```
		formatString: 0
		lineageTag: 0358c2e1-cbbe-4fc3-b3cc-b789c16a0b9b

	measure 'Report1 Branch' = ```
			
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR IsEdgeArtifact = 
			    CALCULATE(
			        MAX(lag_resolved[is_edge_artifact]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR SelR = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_r]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    IsEdgeArtifact = 1, "edge_artifact",
			    ABS(SelR) < 0.5, "weak",
			    "normal"
			)
			```
		lineageTag: f8f5f1d1-7822-4e6f-bf3e-bfa0118293b1

	measure 'Report1 When' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelLag = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_lag]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Gap = 
			    CALCULATE(
			        MAX(lag_resolved[lag_confidence_gap]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR LatestDataDate = CALCULATE(MAX(silver_general[Date]), ALL(silver_general))
			VAR TargetDate = LatestDataDate + (SelLag * 7)
			VAR TargetDateEarlier = LatestDataDate + ((SelLag - 1) * 7)
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "Comparing today's price directly — no reliable time delay found in recent data.",
			    "weak", "",
			    IF(
			        Gap < 0.02,
			        "Effects have historically shown up around " & FORMAT(TargetDateEarlier, "d MMM") & "–" & FORMAT(TargetDate, "d MMM") & ".",
			        "Effects have historically shown up around " & FORMAT(TargetDate, "d MMMM") & "."
			    )
			)
			```
		lineageTag: 1376ebed-f5e2-4af4-aeda-43ff94394271

	measure 'Report1 How Much' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelLag = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_lag]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Slope = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_slope]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR LatestDate = CALCULATE(MAX(silver_general[Date]), ALL(silver_general))
			VAR LagDays = SelLag * 7
			VAR PriorDate = LatestDate - LagDays
			VAR CurrentCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = LatestDate, ALL(silver_general))
			VAR PriorCrude = 
			    CALCULATE(MAX(silver_general[dubai_crude_nzd]), silver_general[Date] = PriorDate, ALL(silver_general))
			VAR CrudeChange = CurrentCrude - PriorCrude
			VAR ContributionCents = Slope * CrudeChange
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "",
			    "weak", "Insufficient historical signal for this fuel right now.",
			    "Recent crude movement (" & FORMAT(CrudeChange, "+0;-0") & " NZD/barrel net, start to end of window) has historically corresponded to " &
			    IF(ContributionCents >= 0, "an increase", "a decrease") & " of about " &
			    FORMAT(ABS(ContributionCents), "0.0") & " c/L — this isolates crude's effect specifically; taxes, margin, ETS and retailer discounts can move independently and aren't included."
			)
			```
		lineageTag: af34525a-e9dd-48fc-a053-9a602cfde04a

	measure 'Report1 Strength' = ```
			
			VAR Branch = [Report1 Branch]
			VAR SelFuel = SELECTEDVALUE(lag_correlation[fuel])
			VAR CurrentPeriodId = 
			    CALCULATE(
			        SELECTEDVALUE(periods[period_id]),
			        FILTER(ALL(periods), periods[start_date] = CALCULATE(MAXX(ALL(periods), periods[start_date]), NOT(ISBLANK(periods[start_date]))))
			    )
			VAR SelR = 
			    CALCULATE(
			        MAX(lag_resolved[resolved_r]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			VAR Prominence = 
			    CALCULATE(
			        MAX(lag_resolved[peak_prominence]),
			        ALL(lag_resolved),
			        lag_resolved[factor] = "dubai_crude_nzd",
			        lag_resolved[target] = "adjusted_retail_price",
			        lag_resolved[fuel] = SelFuel,
			        lag_resolved[period_id] = CurrentPeriodId
			    )
			RETURN
			SWITCH(
			    Branch,
			    "edge_artifact", "",
			    "weak", "",
			    "Confidence: " &
			    SWITCH(
			        TRUE(),
			        ABS(SelR) >= 0.7, "Strong",
			        ABS(SelR) >= 0.5, "Moderate",
			        "Weak"
			    ) & " (correlation value = " & FORMAT(SelR, "0.00") & ")" &
			    IF(Prominence < 0.03, " — consistent across nearby weeks too", "")
			)
			```
		lineageTag: 04437c89-2a91-43d1-8109-6dd5077fd536

