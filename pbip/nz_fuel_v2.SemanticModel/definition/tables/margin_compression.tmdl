table margin_compression
	lineageTag: 92f119e8-73bd-483e-9e53-448092f2d92f

	/// How far the importer margin sits from its own 104-week norm, as a share of that norm. Below zero is compressed. AVERAGE so that a slicer widened to several fuels degrades to their mean instead of adding them up.
	measure 'Margin Gap' = AVERAGE(margin_compression[margin_gap_pct]) / 100
		formatString: 0%;-0%;0%
		lineageTag: 883a2427-1df9-44d1-96a3-4d8f8ff89d80

	/// The same gap with MBIE's fuel market adjustment added back, against a norm built the same way. Exists only for 27 Feb - 11 Sep 2026; blank outside it, never zero.
	measure 'Margin Gap before Adjustment' = AVERAGE(margin_compression[gap_before_adjustment_pct]) / 100
		formatString: 0%;-0%;0%
		lineageTag: 56a121df-4501-49ea-a7f8-a38a7bc780c4

	/// The importer margin as MBIE publishes it, c/L.
	measure 'Importer Margin' = AVERAGE(margin_compression[importer_margin])
		formatString: 0.0
		lineageTag: a28b0708-948f-4203-9861-ca01d7ffd7cb

	/// The mean margin over the 104 weeks before the week, c/L. The week itself is left out of its own norm.
	measure 'Margin Norm 104w' = AVERAGE(margin_compression[margin_norm_104w])
		formatString: 0.0
		lineageTag: d4796cf7-68d5-4f90-9fa5-5b040d63f0ea

	/// The margin with the fuel market adjustment added back, c/L. 27 Feb - 11 Sep 2026 only.
	measure 'Margin before Adjustment' = AVERAGE(margin_compression[margin_before_adjustment])
		formatString: 0.0
		lineageTag: ebcd97e7-23b8-481d-bb93-1a1cd87fcddd

	/// The fuel slicers' fill, the same colours as forecast_accuracy's 'Fuel Colour', under its own name because measure names are unique across the model. A copy, not a reference: the two tables share no relationship, so that measure never sees what a slicer on this table selects. Change both together.
	measure 'Margin Fuel Colour' =
			
			SWITCH(
			    SELECTEDVALUE(margin_compression[fuel]),
			    "Regular Petrol", "#40B54A",
			    "Premium Petrol 95R", "#F7EC14",
			    "Diesel", "#cccccc",
			    "#6b7280"
			)
		lineageTag: 4458db70-b7f1-4cbb-929a-5c80c3f9c83c

	measure 'Margin Now' =
			VAR W = [Latest Week]
			RETURN CALCULATE(AVERAGE(margin_compression[importer_margin]), REMOVEFILTERS(Week), REMOVEFILTERS(margin_compression[week_date]), margin_compression[week_date] = W)
		formatString: 0.0
		displayFolder: Now
		lineageTag: 71668a44-538d-51ca-95c9-244739a9a177

	measure 'Margin Norm Now' =
			VAR W = [Latest Week]
			RETURN CALCULATE(AVERAGE(margin_compression[margin_norm_104w]), REMOVEFILTERS(Week), REMOVEFILTERS(margin_compression[week_date]), margin_compression[week_date] = W)
		formatString: 0.0
		displayFolder: Now
		lineageTag: 511e3d47-7e94-5b63-b3d1-978626571771

	/// The grey track behind the cost pressure bar, 0-60 c/L as in the mock-up. Its own chart under the bar's: a stacked bar dropped both the colour measure and the norm's tick (4 Nov 2026).
	measure 'Track Full' = IF(NOT ISBLANK([Margin Now]), 60)
		formatString: 0
		displayFolder: Now
		lineageTag: 412662c2-2740-5ae6-a8a5-5b8e9555e2d7

	/// Margin Now held to the 0-60 c/L track: a margin above 60 fills the bar, and the figures above it say by how much.
	measure 'Margin Bar' =
			VAR vM = [Margin Now]
			RETURN IF(NOT ISBLANK(vM), MAX(0, MIN(60, vM)))
		formatString: 0.0
		displayFolder: Now
		lineageTag: 47a15ff0-5cf2-5402-8f6d-6e69953a9fcd

	/// Where the norm's tick sits on the same 0-60 c/L track.
	measure 'Margin Norm Bar' =
			VAR vN = [Margin Norm Now]
			RETURN IF(NOT ISBLANK(vN), MAX(0, MIN(60, vN)))
		formatString: 0.0
		displayFolder: Now
		lineageTag: 5a4666d7-eec4-5a27-8bc5-905b9986cc36

	measure 'Margin Gap Now' =
			VAR M = [Margin Now]
			VAR N = [Margin Norm Now]
			RETURN IF(NOT ISBLANK(M) && NOT ISBLANK(N), M - N)
		formatString: +0.0;-0.0;0.0
		displayFolder: Now
		lineageTag: f7f4831d-1651-5f76-9725-0dc8f0db7942

	measure 'Cost Pressure Label' =
			IF(NOT ISBLANK([Margin Gap Now]),
			    FORMAT([Margin Now], "0.0") & " c/L now · average " & FORMAT([Margin Norm Now], "0.0"))
		displayFolder: Now
		lineageTag: 7cdb05da-530b-52a9-ab05-ec285e7e4590

	measure 'Cost Pressure Gap Label' = IF(NOT ISBLANK([Margin Gap Now]), FORMAT([Margin Gap Now], "+0.0;-0.0;0.0") & " c/L")
		displayFolder: Now
		lineageTag: 40d6b7fe-53e8-5fbd-a468-4fc5679333f8

	/// Orange when the margin sits at least 5 c/L under its norm: costs have run ahead of the pump. Same threshold as the headline's "close to".
	measure 'Cost Pressure Colour' = IF([Margin Gap Now] <= -5, "#EB6834", "#8A8983")
		displayFolder: Now
		lineageTag: 89748666-bb76-58a3-8462-19d58e7c9ee1

	measure 'Cost Pressure Heading' =
			"Importer margin against its two-year average, week to " & FORMAT([Latest Week], "d mmm")
			    & " · orange: below average, costs have run ahead of the pump"
		displayFolder: Now
		lineageTag: a105f357-c026-5569-9233-77985b6dd7e0

	/// The margin less its 104-week norm, c/L, week by week: the bars on Margin.
	measure 'Gap (chart)' =
			VAR vM = AVERAGE(margin_compression[importer_margin])
			VAR vN = AVERAGE(margin_compression[margin_norm_104w])
			RETURN IF(NOT ISBLANK(vM) && NOT ISBLANK(vN), vM - vN)
		formatString: +0.0;-0.0;0.0
		displayFolder: Margin
		lineageTag: 9a86007b-87d4-5037-9fd6-739f8815a338

	/// The same gap with MBIE's fuel market adjustment added back, 27 Feb - 11 Sep 2026 only. The gold model gives it as a share of an unadjusted norm; the norm is recovered from the margin and that share.
	measure 'Gap Before Adjustment (chart)' =
			VAR vA = AVERAGE(margin_compression[adjustment_cpl])
			VAR vM = AVERAGE(margin_compression[margin_before_adjustment])
			VAR vP = AVERAGE(margin_compression[gap_before_adjustment_pct])
			RETURN IF(NOT ISBLANK(vA) && NOT ISBLANK(vM) && NOT ISBLANK(vP), vM - DIVIDE(vM, 1 + vP / 100))
		formatString: +0.0;-0.0;0.0
		displayFolder: Margin
		lineageTag: 962592b6-5da9-5f0d-97bf-7d6f9fe56f67

	/// The gap with and without the adjustment where both agree: the nearer one to zero when they share a sign, nothing when they do not.
	measure 'Gap Dark (chart)' =
			VAR vO = [Gap (chart)]
			VAR vU = COALESCE([Gap Before Adjustment (chart)], vO)
			RETURN SWITCH(TRUE(), ISBLANK(vO), BLANK(), vO >= 0 && vU >= 0, MIN(vO, vU), vO <= 0 && vU <= 0, MAX(vO, vU), 0)
		formatString: +0.0;-0.0;0.0
		displayFolder: Margin
		isHidden
		lineageTag: 1cb40a0b-c34a-5441-802a-5ca4272b264d

	measure 'Gap Pale Up (chart)' =
			VAR vO = [Gap (chart)]
			VAR vU = COALESCE([Gap Before Adjustment (chart)], vO)
			RETURN IF(NOT ISBLANK(vO), MAX(MAX(vO, vU), 0))
		formatString: +0.0;-0.0;0.0
		displayFolder: Margin
		isHidden
		lineageTag: 8c91b10c-ebc0-599b-aae1-e15fcdfdd5eb

	measure 'Gap Pale Down (chart)' =
			VAR vO = [Gap (chart)]
			VAR vU = COALESCE([Gap Before Adjustment (chart)], vO)
			RETURN IF(NOT ISBLANK(vO), MIN(MIN(vO, vU), 0))
		formatString: +0.0;-0.0;0.0
		displayFolder: Margin
		isHidden
		lineageTag: cad6c2a5-4ea4-51db-96b6-da21718b1375

	/// Full height in the weeks MBIE suspended cost and margin and filled in later (18 Mar - 1 Jul 2026).
	measure 'Band Up (chart)' =
			VAR vLate = CALCULATE(COUNTROWS(margin_compression), margin_compression[cost_backfilled] = TRUE()) > 0
			RETURN IF(NOT ISBLANK([Gap (chart)]), IF(vLate, [Gap Axis High], 0))
		formatString: 0
		displayFolder: Margin
		isHidden
		lineageTag: e3e2ca46-7523-5467-9d7e-7a95b528db35

	/// Full height in the weeks MBIE suspended cost and margin and filled in later (18 Mar - 1 Jul 2026).
	measure 'Band Down (chart)' =
			VAR vLate = CALCULATE(COUNTROWS(margin_compression), margin_compression[cost_backfilled] = TRUE()) > 0
			RETURN IF(NOT ISBLANK([Gap (chart)]), IF(vLate, [Gap Axis Low], 0))
		formatString: 0
		displayFolder: Margin
		isHidden
		lineageTag: 1b2c126c-69a5-5cdd-8ba0-aa1de663ce43

	/// Orange below the norm, grey above.
	measure 'Gap Colour (chart)' = IF([Gap Dark (chart)] < 0, "#EB6834", "#A3A29B")
		displayFolder: Margin
		isHidden
		lineageTag: 110f7e02-b59f-5bc0-8369-9020bf2dc099

	/// The fuel's own range, with and without the adjustment, plus a margin.
	measure 'Gap Axis Low' =
			VAR vA = CALCULATE(MINX(margin_compression, margin_compression[importer_margin] - margin_compression[margin_norm_104w]), REMOVEFILTERS(Week))
			VAR vB = CALCULATE(MINX(FILTER(margin_compression, NOT ISBLANK(margin_compression[adjustment_cpl]) && NOT ISBLANK(margin_compression[gap_before_adjustment_pct])),
			    margin_compression[margin_before_adjustment] - DIVIDE(margin_compression[margin_before_adjustment], 1 + margin_compression[gap_before_adjustment_pct] / 100)),
			    REMOVEFILTERS(Week))
			RETURN 1.08 * MIN(vA, vB)
		formatString: 0
		displayFolder: Margin
		isHidden
		lineageTag: 18d88dc4-ba9f-53f7-a6ac-b9c092f87d97

	/// The fuel's own range, with and without the adjustment, plus a margin.
	measure 'Gap Axis High' =
			VAR vA = CALCULATE(MAXX(margin_compression, margin_compression[importer_margin] - margin_compression[margin_norm_104w]), REMOVEFILTERS(Week))
			VAR vB = CALCULATE(MAXX(FILTER(margin_compression, NOT ISBLANK(margin_compression[adjustment_cpl]) && NOT ISBLANK(margin_compression[gap_before_adjustment_pct])),
			    margin_compression[margin_before_adjustment] - DIVIDE(margin_compression[margin_before_adjustment], 1 + margin_compression[gap_before_adjustment_pct] / 100)),
			    REMOVEFILTERS(Week))
			RETURN 1.15 * MAX(vA, vB)
		formatString: 0
		displayFolder: Margin
		isHidden
		lineageTag: e20c064f-a0e5-5bd4-bd2b-dcc1c9aaaf4c

	/// The right-hand end of Margin's charts, written under them in place of a date axis.
	measure 'Gap Last Week' = FORMAT([Latest Week], "d mmm yyyy")
		displayFolder: Margin
		lineageTag: d2498b5a-0aa8-52f0-868a-099dc4c169e8

	measure 'Gap Header Date' = IF(NOT ISBLANK([Margin Gap Now]), FORMAT([Latest Week], "d mmm") & ":")
		displayFolder: Margin
		lineageTag: 50b610c0-c1f6-52a8-bc56-4ff3cec70fef

	measure 'Gap Header Value' = IF(NOT ISBLANK([Margin Gap Now]), FORMAT([Margin Gap Now], "+0.0;−0.0;0.0"))
		displayFolder: Margin
		lineageTag: 30142ca7-c95c-5b15-beaa-2843aca4a6f3

	column week_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 3803b224-b1a3-40e5-ba97-aa3eb3bdcaf4
		summarizeBy: none
		sourceColumn: week_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column fuel
		dataType: string
		lineageTag: a09e582b-098b-41e9-b693-dde47520e996
		summarizeBy: none
		sourceColumn: fuel

		annotation SummarizationSetBy = Automatic

	column importer_margin
		dataType: double
		lineageTag: bc1d4bfd-1b4f-40d9-b5e2-285e158776e5
		summarizeBy: none
		sourceColumn: importer_margin

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column margin_norm_104w
		dataType: double
		lineageTag: a5962350-3029-4fd1-9714-d2f75c022172
		summarizeBy: none
		sourceColumn: margin_norm_104w

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column margin_gap_pct
		dataType: double
		lineageTag: 751a868e-7e71-4c9a-83e0-745bb1405e75
		summarizeBy: none
		sourceColumn: margin_gap_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column adjustment_cpl
		dataType: double
		lineageTag: 1ee209b1-18f9-460d-976d-c92977d0425a
		summarizeBy: none
		sourceColumn: adjustment_cpl

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column margin_before_adjustment
		dataType: double
		lineageTag: 915d7b4c-e9b0-49f1-aae1-d200ce977df1
		summarizeBy: none
		sourceColumn: margin_before_adjustment

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column gap_before_adjustment_pct
		dataType: double
		lineageTag: cf53a7fe-3dce-4c4a-b695-383b2898a833
		summarizeBy: none
		sourceColumn: gap_before_adjustment_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column importer_margin_status
		dataType: string
		lineageTag: 1dd8b303-db04-4d0e-976e-f8cd8fe34e5d
		summarizeBy: none
		sourceColumn: importer_margin_status

		annotation SummarizationSetBy = Automatic

	column fuel_market_adjustment
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6a78aaf6-120e-439b-89b3-b02a5f6b24ba
		summarizeBy: none
		sourceColumn: fuel_market_adjustment

		annotation SummarizationSetBy = Automatic

	column cost_backfilled
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: da6f9f11-bced-4883-b4f8-205da65a6ac9
		summarizeBy: none
		sourceColumn: cost_backfilled

		annotation SummarizationSetBy = Automatic

	partition margin_compression = m
		mode: import
		source =
				let
				    Source = Sql.Database("fhi24zxnvquurfybnnzrkz22aq-ae4c5pcutjkedh2gfko4iqwk24.datawarehouse.fabric.microsoft.com", "analytics_warehouse"),
				    dbo_margin_compression = Source{[Schema="dbo",Item="margin_compression"]}[Data]
				in
				    dbo_margin_compression

