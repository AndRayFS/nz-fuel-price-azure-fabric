	measure 'Selected Horizon' = SELECTEDVALUE('Horizon'[Weeks ahead], 1)
		formatString: 0
		isHidden
		displayFolder: Track record
		lineageTag: b3eeb0b1-7884-5387-9bca-c3b4a55616c9

	/// Average absolute miss at the chosen horizon, over every call whose outcome is known since Feb 2013.
	measure 'Miss Model' =
			VAR vH = [Selected Horizon]
			RETURN CALCULATE(AVERAGE(forecast_accuracy[abs_err_adl_ecm]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[outcome_known] = TRUE())
		formatString: 0.0
		displayFolder: Track record
		lineageTag: c43dc23d-0cc1-5522-88de-0abc371d5eb1

	/// Average absolute miss at the chosen horizon, over every call whose outcome is known since Feb 2013.
	measure 'Miss No Change' =
			VAR vH = [Selected Horizon]
			RETURN CALCULATE(AVERAGE(forecast_accuracy[abs_err_naive]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[outcome_known] = TRUE())
		formatString: 0.0
		displayFolder: Track record
		lineageTag: 4df74c81-6698-53e5-b8fd-ef496cac41d4

	measure 'Track Headline' =
			VAR vH = [Selected Horizon]
			VAR vFuel = SELECTEDVALUE(Fuel[Fuel name])
			VAR vM = [Miss Model]
			VAR vN = [Miss No Change]
			VAR vPct = ROUND(100 * ABS(1 - DIVIDE(vM, vN)), 0)
			RETURN IF(NOT ISBLANK(vFuel) && vN > 0,
			    "Since 2013 the model's " & SWITCH(vH, 1, "one", 2, "two", 3, "three") & "-week call for " & vFuel
			    & " has missed by " & FORMAT(vM, "0.0") & " c/L on average — " & vPct & "% "
			    & IF(vM <= vN, "less", "more") & " than assuming the price won't change.")
		displayFolder: Track record
		lineageTag: 910fd39a-e072-563e-b4fe-0e6b65aa0b5a

	/// Trailing 26-week average miss at the week called; full windows only, so the line starts in Aug 2013.
	measure 'Model 26w (chart)' =
			VAR vH = [Selected Horizon]
			RETURN CALCULATE(AVERAGE(forecast_accuracy[mae_model_26w]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26)
		formatString: 0.0
		displayFolder: Track record
		lineageTag: 3911e25a-bb7a-5469-83f4-60e14227b034

	/// Trailing 26-week average miss at the week called; full windows only, so the line starts in Aug 2013.
	measure 'No Change 26w (chart)' =
			VAR vH = [Selected Horizon]
			RETURN CALCULATE(AVERAGE(forecast_accuracy[mae_naive_26w]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26)
		formatString: 0.0
		displayFolder: Track record
		lineageTag: 384828de-c330-56a3-80ef-47d3ba5412ce

	measure 'Track Last Week' =
			VAR vH = [Selected Horizon]
			RETURN CALCULATE(MAX(forecast_accuracy[Target week]), REMOVEFILTERS(Week), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26)
		isHidden
		displayFolder: Track record
		lineageTag: 3904a670-bc22-5b3c-b50a-47c164825a89

	measure 'Model 26w (last)' = IF(MAX(Week[week]) = [Track Last Week], [Model 26w (chart)])
		formatString: 0.0
		displayFolder: Track record
		lineageTag: a8c27304-9190-59b5-93ec-060dc94a1693

	measure 'No Change 26w (last)' = IF(MAX(Week[week]) = [Track Last Week], [No Change 26w (chart)])
		formatString: 0.0
		displayFolder: Track record
		lineageTag: 99a3b80b-7f76-51ff-851c-372fc7bc5da4

	measure 'Track Axis Top' =
			VAR vH = [Selected Horizon]
			VAR vA = CALCULATE(MAX(forecast_accuracy[mae_naive_26w]), REMOVEFILTERS(Week), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26)
			VAR vB = CALCULATE(MAX(forecast_accuracy[mae_model_26w]), REMOVEFILTERS(Week), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26)
			RETURN 1.1 * MAX(vA, vB)
		formatString: 0.0
		isHidden
		displayFolder: Track record
		lineageTag: ea26871b-a180-5aeb-bcab-fbd8579ef634

	/// A full-height column in weeks whose call was made in volatile crude: the shading behind the lines.
	measure 'Volatile (chart)' =
			VAR vH = [Selected Horizon]
			VAR vHigh = CALCULATE(COUNTROWS(forecast_accuracy), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[window_n] = 26, forecast_accuracy[crude_vol_regime] = "high")
			RETURN IF(vHigh > 0, [Track Axis Top])
		formatString: 0.0
		displayFolder: Track record
		lineageTag: e01332a7-f33f-5a9d-8124-f68a585e80cc

	measure 'Miss Model (row)' =
			VAR vH = SELECTEDVALUE('Track Row'[Weeks ahead])
			VAR vR = SELECTEDVALUE('Track Row'[Regime])
			RETURN IF(NOT ISBLANK(vH), CALCULATE(AVERAGE(forecast_accuracy[abs_err_adl_ecm]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[crude_vol_regime] = vR, forecast_accuracy[outcome_known] = TRUE()))
		formatString: 0.0
		displayFolder: Track record
		lineageTag: 382212a0-c508-53b2-80a1-433ea24a69e6

	measure 'Miss No Change (row)' =
			VAR vH = SELECTEDVALUE('Track Row'[Weeks ahead])
			VAR vR = SELECTEDVALUE('Track Row'[Regime])
			RETURN IF(NOT ISBLANK(vH), CALCULATE(AVERAGE(forecast_accuracy[abs_err_naive]), forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[crude_vol_regime] = vR, forecast_accuracy[outcome_known] = TRUE()))
		formatString: 0.0
		displayFolder: Track record
		lineageTag: a2ff1852-67e1-5768-8e15-6952f3f5d4bb

	/// The chosen horizon's rows only, for the full-colour layer over the muted chart; 0 rather than blank elsewhere, so every row keeps its place.
	measure 'Miss Model (row, chosen)' =
			VAR vH = SELECTEDVALUE('Track Row'[Weeks ahead])
			RETURN IF(NOT ISBLANK(vH), IF(vH = [Selected Horizon], [Miss Model (row)], 0))
		formatString: 0.0
		isHidden
		displayFolder: Track record
		lineageTag: c0c8c453-11e4-55db-a1b6-48821a3062a3

	/// The chosen horizon's rows only, for the full-colour layer over the muted chart; 0 rather than blank elsewhere, so every row keeps its place.
	measure 'Miss No Change (row, chosen)' =
			VAR vH = SELECTEDVALUE('Track Row'[Weeks ahead])
			RETURN IF(NOT ISBLANK(vH), IF(vH = [Selected Horizon], [Miss No Change (row)], 0))
		formatString: 0.0
		isHidden
		displayFolder: Track record
		lineageTag: ea020534-102f-5695-b3b1-199520010500

	/// One axis end for both layers of the right-hand chart, so their bars line up.
	measure 'Rows Axis End' = 1.15 * MAXX(ALL('Track Row'), MAX([Miss Model (row)], [Miss No Change (row)]))
		formatString: 0.0
		isHidden
		displayFolder: Track record
		lineageTag: f5d5ecd6-10e1-5329-9c1b-27dff471d788

	/// Left chart's title: the volatile-crude episode where the model beat no change by most, and any where it did worse.
	measure 'Track Lead Title' =
			VAR vH = [Selected Horizon]
			VAR vEp = ADDCOLUMNS(
			    CALCULATETABLE(VALUES(forecast_accuracy[crude_episode_id]), forecast_accuracy[horizon_weeks] = vH,
			        forecast_accuracy[outcome_known] = TRUE(), NOT ISBLANK(forecast_accuracy[crude_episode_id])),
			    "lead", CALCULATE(AVERAGE(forecast_accuracy[abs_err_naive]) - AVERAGE(forecast_accuracy[abs_err_adl_ecm]),
			        forecast_accuracy[horizon_weeks] = vH, forecast_accuracy[outcome_known] = TRUE()))
			VAR vTop = MAXX(TOPN(1, vEp, [lead], DESC), forecast_accuracy[crude_episode_id])
			VAR vLow = TOPN(1, vEp, [lead], ASC)
			VAR vLowId = MAXX(vLow, forecast_accuracy[crude_episode_id])
			VAR vLowLead = MAXX(vLow, [lead])
			RETURN IF(NOT ISBLANK(vTop),
			    "The model's lead is widest in the " & SWITCH(vTop, "2026_iran_us", "2026 Iran–US shock", "2022_ukraine", "2022 Ukraine shock", "2020_covid_crash", "2020 COVID crash",
			    "2016_opec_cuts", "2016 OPEC cuts", "2016_glut_trough", "2015–16 glut trough", "2015_glut_onset", "2015 glut onset", SUBSTITUTE(vTop, "_", " "))
			    & IF(vLowLead < 0, "; in the " & SWITCH(vLowId, "2026_iran_us", "2026 Iran–US shock", "2022_ukraine", "2022 Ukraine shock", "2020_covid_crash", "2020 COVID crash",
			    "2016_opec_cuts", "2016 OPEC cuts", "2016_glut_trough", "2015–16 glut trough", "2015_glut_onset", "2015 glut onset", SUBSTITUTE(vLowId, "_", " ")) & " no change did better", ""))
		displayFolder: Track record
		lineageTag: 91b26900-d996-5edb-8a99-775608be2452

	/// Right chart's title: how much volatile crude multiplies both methods' miss, and in how many of the six rows the model still wins.
	measure 'Track Regime Title' =
			VAR vRows = ADDCOLUMNS('Track Row', "m", [Miss Model (row)], "n", [Miss No Change (row)])
			VAR vR = DIVIDE(SUMX(FILTER(vRows, 'Track Row'[Regime] = "high"), [m] + [n]), SUMX(FILTER(vRows, 'Track Row'[Regime] = "normal"), [m] + [n]))
			VAR vLeads = COUNTROWS(FILTER(vRows, [m] < [n]))
			VAR vA = SWITCH(TRUE(), vR < 1.25, "Volatile weeks barely change anyone's miss", vR < 1.75, "Volatile weeks add half again to everyone's miss",
			                vR < 2.5, "Volatile weeks double everyone's miss", vR < 3.5, "Volatile weeks triple everyone's miss",
			                "Volatile weeks multiply everyone's miss " & FORMAT(vR, "0") & "-fold")
			VAR vB = SWITCH(TRUE(), vLeads = 6, "the model keeps its lead", vLeads = 0, "no change does better throughout",
			                "the model leads in " & vLeads & " of 6")
			RETURN IF(NOT ISBLANK(vR), vA & "; " & vB)
		displayFolder: Track record
		lineageTag: 1a4db271-ea52-5476-b534-09cad9b8b095

