table forecast_accuracy
	lineageTag: c247b326-93c8-470a-bf56-06a81d7a6cc1

	/// The model's calls made in the newest week for the three weeks after it, starting from the last price paid so the line leaves from it.
	measure 'Call (chart)' =
			VAR W = MAX(Week[week])
			VAR Latest = [Latest Week]
			RETURN
			SWITCH(
			    TRUE(),
			    W = Latest, [Average Paid],
			    W > Latest && W <= Latest + 21,
			        CALCULATE(AVERAGE(forecast_accuracy[pred_adl_ecm]), forecast_accuracy[week_date] = Latest)
			)
		formatString: 0.0
		displayFolder: Now
		lineageTag: 4d9e1728-3175-58e8-8998-d0c3a49b3530

	/// Edge of the band around the calls: the call plus the 25th percentile of past misses (actual minus call) at the same horizon, in weeks of the same crude-volatility regime as the newest, all three fuels pooled, outcomes known by the newest week. Agreed in the review of 19 Oct: the middle half of misses in weeks like this one, so the band widens when crude is volatile.
	measure 'Call Low (chart)' =
			VAR vWeek = MAX(Week[week])
			VAR vLatest = [Latest Week]
			VAR vH = INT((vWeek - vLatest) / 7)
			VAR vCall = [Call (chart)]
			VAR vRegime =
			    CALCULATE(
			        MAX(forecast_accuracy[crude_vol_regime]),
			        REMOVEFILTERS(Week), REMOVEFILTERS(Fuel),
			        forecast_accuracy[week_date] = vLatest
			    )
			RETURN
			IF(
			    NOT ISBLANK(vCall),
			    IF(
			        vH = 0,
			        vCall,
			        // Only for the three called weeks, so the percentile never runs on an empty set.
			        vCall
			            + PERCENTILEX.INC(
			                CALCULATETABLE(
			                    forecast_accuracy,
			                    REMOVEFILTERS(Week), REMOVEFILTERS(Fuel),
			                    forecast_accuracy[crude_vol_regime] = vRegime,
			                    forecast_accuracy[horizon_weeks] = vH,
			                    forecast_accuracy[outcome_known] = TRUE(),
			                    forecast_accuracy[Target week] <= vLatest
			                ),
			                forecast_accuracy[actual_price] - forecast_accuracy[pred_adl_ecm],
			                0.25
			            )
			    )
			)
		formatString: 0.0
		displayFolder: Now
		lineageTag: d28ffe54-6f07-55d9-b0e6-e4acbf3b7122

	/// Edge of the band around the calls: the call plus the 75th percentile of past misses (actual minus call) at the same horizon, in weeks of the same crude-volatility regime as the newest, all three fuels pooled, outcomes known by the newest week. Agreed in the review of 19 Oct: the middle half of misses in weeks like this one, so the band widens when crude is volatile.
	measure 'Call High (chart)' =
			VAR vWeek = MAX(Week[week])
			VAR vLatest = [Latest Week]
			VAR vH = INT((vWeek - vLatest) / 7)
			VAR vCall = [Call (chart)]
			VAR vRegime =
			    CALCULATE(
			        MAX(forecast_accuracy[crude_vol_regime]),
			        REMOVEFILTERS(Week), REMOVEFILTERS(Fuel),
			        forecast_accuracy[week_date] = vLatest
			    )
			RETURN
			IF(
			    NOT ISBLANK(vCall),
			    IF(
			        vH = 0,
			        vCall,
			        // Only for the three called weeks, so the percentile never runs on an empty set.
			        vCall
			            + PERCENTILEX.INC(
			                CALCULATETABLE(
			                    forecast_accuracy,
			                    REMOVEFILTERS(Week), REMOVEFILTERS(Fuel),
			                    forecast_accuracy[crude_vol_regime] = vRegime,
			                    forecast_accuracy[horizon_weeks] = vH,
			                    forecast_accuracy[outcome_known] = TRUE(),
			                    forecast_accuracy[Target week] <= vLatest
			                ),
			                forecast_accuracy[actual_price] - forecast_accuracy[pred_adl_ecm],
			                0.75
			            )
			    )
			)
		formatString: 0.0
		displayFolder: Now
		lineageTag: f5eb735d-52f5-5deb-bbf5-7a09ca3de4c2

	/// The week the model's call is for, set over the number below it.
	measure 'Call Date 1' =
			VAR vLatest = [Latest Week]
			RETURN IF(NOT ISBLANK(vLatest), FORMAT(vLatest + 7, "d mmm"))
		displayFolder: Now
		lineageTag: 587d76e9-c7ba-5bdf-a239-bbe46d94593a

	/// The call made in the newest week for 1 week(s) ahead, in whole cents, as text so it can be set in a title. Three fixed slots replace the matrix, which bunched its columns to the left.
	measure 'Call 1' =
			VAR vLatest = [Latest Week]
			VAR vCall =
			    CALCULATE(
			        AVERAGE(forecast_accuracy[pred_adl_ecm]),
			        REMOVEFILTERS(Week),
			        forecast_accuracy[week_date] = vLatest,
			        forecast_accuracy[horizon_weeks] = 1
			    )
			RETURN IF(NOT ISBLANK(vCall), FORMAT(vCall, "0"))
		displayFolder: Now
		lineageTag: 5584e450-6651-5e96-9de7-41f7427478cc

	measure 'Call Date 2' =
			VAR vLatest = [Latest Week]
			RETURN IF(NOT ISBLANK(vLatest), FORMAT(vLatest + 14, "d mmm"))
