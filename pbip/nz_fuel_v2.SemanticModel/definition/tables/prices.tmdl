			VAR vW = [Latest Week]
			RETURN CALCULATE(AVERAGE(prices[gst]), REMOVEFILTERS(Week), prices[week_date] = vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
		lineageTag: 7ee0ce66-c169-58c6-9225-a31a0cc393fb

	measure 'GST Average (c/L)' =
			VAR vW = [Latest Week]
			RETURN CALCULATE(AVERAGE(prices[gst]), REMOVEFILTERS(Week), prices[week_date] >= DATE(2024, 3, 29), prices[week_date] <= vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
		lineageTag: 20c48e65-cd6b-5135-ab5c-863878f5d8e4

	measure 'Margin Now (c/L)' =
			VAR vW = [Latest Week]
			RETURN CALCULATE(AVERAGE(prices[importer_margin]), REMOVEFILTERS(Week), prices[week_date] = vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
		lineageTag: 7a89d068-9bc3-50d9-bb62-efa2764e31aa

	measure 'Margin Average (c/L)' =
			VAR vW = [Latest Week]
			RETURN CALCULATE(AVERAGE(prices[importer_margin]), REMOVEFILTERS(Week), prices[week_date] >= DATE(2024, 3, 29), prices[week_date] <= vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
		lineageTag: 31bbd6b2-e328-563f-be31-70fa071d332a

	measure 'Price Now (c/L)' =
			VAR vW = [Latest Week]
			RETURN CALCULATE(AVERAGE(prices[adjusted_retail_price]), REMOVEFILTERS(Week), prices[week_date] = vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
