			RETURN CALCULATE(AVERAGE(prices[adjusted_retail_price]), REMOVEFILTERS(Week), prices[week_date] >= DATE(2024, 3, 29), prices[week_date] <= vW)
		formatString: 0.0
		displayFolder: Margin
		isHidden
		lineageTag: a1531fae-c3ab-5300-91c2-ee078245e6a5

	measure 'Cost Bar (now)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", [Cost Now (c/L)], 0)
		displayFolder: Margin
		lineageTag: a7520f41-b268-569c-91a6-9ef20a67a440

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", """" & FORMAT(DIVIDE([Cost Now (c/L)], [Price Now (c/L)]), "0%") & """", "0")

	measure 'Cost Bar (average)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", [Cost Average (c/L)], 0)
