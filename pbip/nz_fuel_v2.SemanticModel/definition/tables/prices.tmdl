	measure 'ETS Bar (now)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", [ETS Now (c/L)], 0)
		displayFolder: Margin
		lineageTag: 40cd9a30-3ce8-58e5-bd2b-63b79e7da18c

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", """" & FORMAT(DIVIDE([ETS Now (c/L)], [Price Now (c/L)]), "0%") & """", "0")

	measure 'ETS Bar (average)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", [ETS Average (c/L)], 0)
		displayFolder: Margin
		lineageTag: cfe2a621-7993-5fcd-aa5d-71fe459a8098

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", """" & FORMAT(DIVIDE([ETS Average (c/L)], [Price Average (c/L)]), "0%") & """", "0")

	measure 'GST Bar (now)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", [GST Now (c/L)], 0)
		displayFolder: Margin
		lineageTag: 19859e9c-c3bd-5ba0-a5ac-169e8c06f665

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", """" & FORMAT(DIVIDE([GST Now (c/L)], [Price Now (c/L)]), "0%") & """", "0")

	measure 'GST Bar (average)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", [GST Average (c/L)], 0)
		displayFolder: Margin
		lineageTag: 34504106-2a48-58d8-a1f4-61bb24431102

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", """" & FORMAT(DIVIDE([GST Average (c/L)], [Price Average (c/L)]), "0%") & """", "0")

	measure 'Margin Bar (now)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", [Margin Now (c/L)], 0)
		displayFolder: Margin
		lineageTag: a6d090c6-846f-5623-bb14-5e1285686f51

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Newest week", """" & FORMAT(DIVIDE([Margin Now (c/L)], [Price Now (c/L)]), "0%") & """", "0")

	measure 'Margin Bar (average)' = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", [Margin Average (c/L)], 0)
		displayFolder: Margin
		lineageTag: bfd3a814-ce3f-51d0-b717-4f5682954856

		formatStringDefinition = IF(SELECTEDVALUE('Share Row'[Kind]) = "Average", """" & FORMAT(DIVIDE([Margin Average (c/L)], [Price Average (c/L)]), "0%") & """", "0")

	/// One c/L scale for every bar on Margin's right: the dearest litre, this week or on average, of the three fuels.
	measure 'Share Axis End' = MAX(MAXX(ALL(Fuel), [Price Now (c/L)]), MAXX(ALL(Fuel), [Price Average (c/L)]))
		formatString: 0
		displayFolder: Margin
		isHidden
		lineageTag: 90c54a51-036e-543d-8632-41ced5f614ce

	measure 'Share Date' = FORMAT([Latest Week], "d mmm")
		displayFolder: Margin
		lineageTag: af35f79a-42cf-5506-a8a3-f126927b3a13

	measure 'Share Price Now' = FORMAT([Price Now (c/L)], "0.0") & " c/L"
		displayFolder: Margin
		lineageTag: b442b4bb-8efa-5d2b-b6e2-c10d4c8d07c8

	measure 'Share Price Average' = FORMAT([Price Average (c/L)], "0.0") & " c/L"
		displayFolder: Margin
		lineageTag: e4baa197-24ea-50ec-8f70-edcaeaef7bbc

	measure 'Share Subtitle' = "Week of " & FORMAT([Latest Week], "d mmm") & ", dark, against the average since 29 Mar 2024, pale · one c/L scale · labels are shares of the price"
		displayFolder: Margin
		lineageTag: 682f9567-6060-5520-a2db-2f6127214131

	measure 'Share Title' =
			// A claim, as the mock-up's title is, but only the part all three fuels agree on:
			// a share within a point of its average counts as usual.
			VAR vCost = ADDCOLUMNS(ALL(Fuel), "d", DIVIDE([Cost Now (c/L)], [Price Now (c/L)]) - DIVIDE([Cost Average (c/L)], [Price Average (c/L)]),
			                                   "m", DIVIDE([Margin Now (c/L)], [Price Now (c/L)]) - DIVIDE([Margin Average (c/L)], [Price Average (c/L)]))
			VAR vCostUp = COUNTROWS(FILTER(vCost, [d] >= 0.01))
			VAR vCostDown = COUNTROWS(FILTER(vCost, [d] <= -0.01))
			VAR vMarginUp = COUNTROWS(FILTER(vCost, [m] >= 0.01))
			VAR vMarginDown = COUNTROWS(FILTER(vCost, [m] <= -0.01))
			VAR vA = SWITCH(TRUE(), vCostUp = 3, "Cost takes a bigger share of every litre than usual",
			                        vCostDown = 3, "Cost takes a smaller share of every litre than usual",
			                        "Where each litre goes, against the usual")
			VAR vB = SWITCH(TRUE(), vMarginDown = 3, ", the margin a smaller one", vMarginUp = 3, ", the margin a bigger one", "")
			RETURN vA & vB
		displayFolder: Margin
		lineageTag: 4e7918d0-500e-5f8a-b8a3-89c7757f6d9b

	measure 'Margin Share Now Label' = FORMAT(DIVIDE([Margin Now (c/L)], [Price Now (c/L)]), "0.0%")
		displayFolder: Margin
		lineageTag: 6be4372a-085f-5ab0-8e02-ca4c803ced91

	measure 'Margin Share Average Label' = FORMAT(DIVIDE([Margin Average (c/L)], [Price Average (c/L)]), "0.0%")
		displayFolder: Margin
		lineageTag: 83985d86-46d6-53c7-8b45-16208856bbb8

	/// Margin's title: what a squeeze means, then where the margins stand now, in Now's words.
	measure 'Margin Headline' =
			VAR vB = [Headline Margin Clause]
			RETURN "A squeezed margin is a cost rise the pump has not passed on yet." & IF(vB <> "", " " & vB)
		displayFolder: Margin
		lineageTag: e03d5d7d-9e91-506e-a1b0-2e7775cbece5

