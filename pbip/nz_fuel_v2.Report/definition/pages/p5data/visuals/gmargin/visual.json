    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Margin",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — what is left of the pump price after taxes, GST, ETS and MBIE's estimate of the importer's cost.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Two-year average",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — the margin's average over the 104 weeks before.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gap",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — the margin less its two-year average.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Before MBIE's adjustment",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — from 27 Feb 2026 MBIE adds to the cost what the Commerce Commission found importers paid above the benchmarks; these columns leave it out. Split published to 11 Sep.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Filled in later",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — weeks MBIE suspended and published afterwards.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              }
            ]
