              {
                "textRuns": [
                  {
                    "value": "Call made",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — the week the model made its call, using only the data of that week.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Model's call",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — the price it indicated for the week the call was for.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "“No change”",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — the benchmark: the price stays where it was, so its call is the price then.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Missed by",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1B1B19"
                    }
                  },
                  {
                    "value": " — how far a call sat from the price that followed, in cents per litre.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5C5B56"
                    }
                  }
                ]
              }
            ]
